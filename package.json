{
  "name": "gig_simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "cy": "cypress open",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "dep:check": "depcruise src",
    "dep:graph": "depcruise src --output-type mermaid --output-to dependency-graph.mmd",
    "dep:svg": "depcruise src --output-type dot | dot -T svg -o dependency-graph.svg",
    "dep:html": "depcruise src --output-type x-dot-webpage --output-to dependency-graph.html"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.2",
    "oxfmt": "^0.66.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.2",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^15.18.0",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.24.0",
    "sonda": "^0.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9",
    "vitest-localstorage-mock": "^0.1.2"
  }
}
